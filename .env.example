# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Note: Consumer Google AI Pro subscriptions do NOT provide Gemini API credits.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Preferred Gemini model (free-tier compatible by default).
GEMINI_MODEL="gemini-3.8-flash"

# ALLOW_PAID_MODELS: Disabled by default to prevent unexpected API expenditure.
ALLOW_PAID_MODELS="false"

# DAILY_AI_LIMIT: Maximum daily AI requests allowed under cost protection.
DAILY_AI_LIMIT="50"

# MAX_OUTPUT_TOKENS: Maximum output tokens per AI request.
MAX_OUTPUT_TOKENS="2048"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
